---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import mlvLogo from "../assets/donativos/mlv-logo.svg";
import mlvNombre from "../assets/donativos/mlv-nombre.svg";

interface Props {
  title: string;
  description: string;
  logo: ImageMetadata;
  logoAlt: string;
  logoWidth: number;
  logoHeight: number;
  theme: "dark" | "light";
}

const { title, description, logo, logoAlt, logoWidth, logoHeight, theme } = Astro.props;

// Copy from the live site mlv-andres.vercel.app (/donativos/binance, /donativos/paypal);
// the e-mail is masked there and stays masked until the real address is supplied.
---

<BaseLayout title={title} description={description} menu={false}>
  <main>
    <header class="cabeza">
      <a href="/" aria-label="Movimiento Libertario de Venezuela — Inicio">
        <Image src={mlvLogo} alt="" width={154} height={145} class="cabeza__logo" />
        <Image src={mlvNombre} alt="Movimiento Libertario de Venezuela" width={279} height={107} class="cabeza__nombre" />
      </a>
    </header>

    <section class={`pago pago--${theme}`}>
      <div class="pago__inner">
        <Image class="pago__logo" src={logo} alt={logoAlt} width={logoWidth} height={logoHeight} />
        <h1>CADA COLABORACIÓN<br />CUENTA</h1>
        <div class="text">
          <p>
            Aquí te dejamos la información necesaria para realizar la colaboración, ante cualquier duda no dudes en comunicarte con el siguiente correo ************
          </p>
          <p>Gracias por apoyarnos y seguir con nosotros pana libertario</p>
        </div>
        <span class="pago__cta">SOLICITA TU INFORMACIÓN</span>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Header: 209 px gold band, logo + name centred. */
  .cabeza {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 209px;
    background: var(--color-brand-yellow);
  }
  .cabeza a {
    display: flex;
    align-items: center;
    gap: 19px;
  }
  .cabeza :global(.cabeza__logo) {
    width: 154px;
    height: 145px;
  }
  .cabeza :global(.cabeza__nombre) {
    width: 279px;
    height: 107px;
  }

  /* Payment info: 876 px band, content column 1164 px, first line at y 88. */
  .pago--dark {
    background: var(--color-ink);
    color: var(--color-white);
  }
  .pago--light {
    background: var(--color-white);
    color: var(--color-ink);
  }
  .pago__inner {
    max-width: 1164px;
    min-height: 876px;
    margin-inline: auto;
    padding: 88px 0 251px;
  }
  .pago__logo {
    display: block;
    margin-inline: auto;
  }
  .pago h1 {
    max-width: 640px;
    margin-top: 123px;
    font-size: var(--fs-48);
    line-height: 1.2;
    text-transform: uppercase;
  }
  .text {
    max-width: 1090px;
    margin-top: 30px;
    font-family: var(--font-body);
    font-size: var(--fs-18);
    line-height: 1.3;
    text-align: justify;
  }
  .text p + p {
    margin-top: 20px;
  }
  .pago__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 241px;
    height: 43px;
    margin-top: 30px;
    padding-inline: 28px;
    border-radius: 95px;
    background: var(--color-brand-yellow);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--fs-18);
    white-space: nowrap;
  }

  /* Tablet and mobile (derived): smaller header and column padding. */
  @media (max-width: 1024px) {
    .cabeza {
      height: 150px;
    }
    .cabeza :global(.cabeza__logo) {
      width: 100px;
      height: auto;
    }
    .cabeza :global(.cabeza__nombre) {
      width: 180px;
      height: auto;
    }
    .pago__inner {
      min-height: 0;
      padding: 56px var(--page-gutter) 80px;
    }
    .pago :global(.pago__logo) {
      max-width: 70%;
      height: auto;
    }
    .pago h1 {
      margin-top: 56px;
      font-size: var(--fs-40);
    }
    .text {
      font-size: var(--fs-16);
    }
  }
  @media (max-width: 640px) {
    .cabeza {
      height: 110px;
    }
    .cabeza :global(.cabeza__logo) {
      width: 64px;
    }
    .cabeza :global(.cabeza__nombre) {
      width: 120px;
    }
    .pago h1 {
      font-size: var(--fs-32);
    }
    .text {
      text-align: left;
    }
    .pago__cta {
      min-width: 0;
      width: 100%;
      white-space: normal;
      text-align: center;
    }
  }
</style>
